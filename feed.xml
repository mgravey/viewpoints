---
layout: null
permalink: /feed.xml
sitemap: false
---
<?xml version="1.0" encoding="utf-8"?>
{%- comment -%}
  Atom feed of published topics. Replaces jekyll-feed, which only filters
  `draft: true` and would publish `status: draft` topics.
{%- endcomment %}
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="en">
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml" />
  <link href="{{ '/' | absolute_url }}" rel="alternate" type="text/html" hreflang="en" />
  <updated>{{ site.time | date_to_xmlschema }}</updated>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <title type="html">{{ site.title | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <author>
    <name>{{ site.author.name | xml_escape }}</name>
    <uri>{{ site.author.url | xml_escape }}</uri>
  </author>
  <rights>CC BY-SA 4.0 (https://creativecommons.org/licenses/by-sa/4.0/)</rights>
{%- assign notes = site.topics | where_exp: "n", "n.status != 'draft'" | sort: "date" | reverse %}
{%- assign cdata_end_token = "]]>" %}
{%- assign cdata_end_token_escaped = "]]]]><![CDATA[>" %}
{%- for note in notes limit: 20 %}
  {%- assign note_title = note.title | strip_html | normalize_whitespace | xml_escape %}
  <entry>
    <title type="html">{{ note_title }}</title>
    <link href="{{ note.url | absolute_url }}" rel="alternate" type="text/html" title="{{ note_title }}" />
    <published>{{ note.date | date_to_xmlschema }}</published>
    <updated>{{ note.updated | default: note.date | date_to_xmlschema }}</updated>
    <id>{{ note.url | absolute_url | xml_escape }}</id>
    <content type="html" xml:base="{{ note.url | absolute_url | xml_escape }}"><![CDATA[{{ note.content | strip | replace: cdata_end_token, cdata_end_token_escaped }}]]></content>
    <author>
      <name>{{ site.author.name | xml_escape }}</name>
    </author>
    {%- if note.topic %}
    <category term="{{ note.topic | xml_escape }}" />
    {%- endif %}
    {%- for tag in note.tags %}
    <category term="{{ tag | xml_escape }}" />
    {%- endfor %}
    <summary type="html"><![CDATA[{{ note.summary | strip_html | normalize_whitespace | replace: cdata_end_token, cdata_end_token_escaped }}]]></summary>
    {%- if note.image %}
    <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ note.image | absolute_url | xml_escape }}" />
    {%- endif %}
  </entry>
{%- endfor %}
</feed>
